        "test": "vitest run"
    },
    "dependencies": {
        "@autonoma/errors": "workspace:*",
        "@autonoma/logger": "workspace:*",
        "@modelcontextprotocol/sdk": "catalog:",
        "@t3-oss/env-core": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
