{
    "name": "@autonoma/mcp-client",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./env": "./src/env.ts"
    },
    "scripts": {
        "build": "tsc --noCheck",
        "typecheck": "tsc --noEmit",
