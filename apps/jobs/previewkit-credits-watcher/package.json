{
    "name": "@autonoma/job-previewkit-credits-watcher",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "start": "dotenv -e ../../../.env -- tsx src/index.ts",
        "build": "rolldown -c rolldown.config.ts",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --fix src/",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "@autonoma/billing": "workspace:*",
        "@autonoma/db": "workspace:*",
        "@autonoma/k8s": "workspace:*",
        "@autonoma/logger": "workspace:*",
        "@sentry/node": "catalog:",
        "@t3-oss/env-core": "catalog:",
        "dotenv-cli": "^11.0.0",
        "tsx": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rolldown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
